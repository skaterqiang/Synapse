# Electron 二进制下载镜像。
# 默认源 https://github.com/electron/electron/releases/download/ 在部分网络下
# 不可达，会导致 `npm start` 报 "TypeError: fetch failed" +
# "Electron failed to install correctly"。
# 与 package-lock.json 中 electron 已解析自 registry.npmmirror.com 保持一致。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
