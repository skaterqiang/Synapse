{
  "name": "synapse",
  "productName": "Synapse",
  "version": "1.0.0",
  "description": "Synapse 本地个人知识库助手：Markdown 笔记、LLM Wiki、知识图谱、AI 智能问答",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node web/server.js",
    "postinstall": "codesign --force --deep --sign - node_modules/electron/dist/Electron.app || true",
    "dist": "electron-builder --win",
    "dist:win": "powershell -ExecutionPolicy Bypass -File build-win.ps1",
    "dist:mac": "bash build-mac.sh"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "marked": "^12.0.2",
    "pdfkit": "^0.19.1"
  },
  "build": {
    "appId": "com.personal.knowledge-assistant",
    "productName": "Synapse",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/sql.js/dist/*.wasm"
    ],
    "extraResources": [
      {
        "from": "data/llmwiki",
        "to": "llmwiki"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "sql.js": "^1.14.1",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  }
}
