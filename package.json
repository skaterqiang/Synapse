{
  "name": "synapse",
  "productName": "Synapse",
  "version": "1.0.0",
  "description": "Synapse 本地个人知识库助手：Markdown 笔记、LLM Wiki、知识图谱、AI 智能问答",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "marked": "^12.0.2",
    "pdfkit": "^0.19.1"
  },
  "build": {
    "appId": "com.personal.knowledge-assistant",
    "productName": "Synapse",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "sql.js": "^1.14.1",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  }
}
