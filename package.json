{
  "name": "synapse",
  "productName": "Synapse",
  "version": "1.0.0",
  "description": "Synapse 本地个人知识库助手：Markdown 笔记、LLM Wiki、知识图谱、AI 智能问答",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/ensure-mac-sign.js",
    "start": "electron .",
    "start:gui": "node scripts/ensure-mac-sign.js && open -n node_modules/electron/dist/Electron.app --args \"$PWD\"",
    "web": "node web/server.js",
    "serve": "node scripts/start-web.js",
    "test:mcp": "node test/mcp-client.test.js",
    "sync-libs": "node scripts/sync-libs.js",
    "postinstall": "node scripts/ensure-mac-sign.js && node scripts/sync-libs.js",
    "dist": "electron-builder --win",
    "dist:win": "powershell -ExecutionPolicy Bypass -File build-win.ps1",
    "dist:mac": "bash build-mac.sh"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.14",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "marked": "^18.0.11",
    "pdfkit": "^0.20.1"
  },
  "build": {
    "appId": "com.personal.knowledge-assistant",
    "productName": "Synapse",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "docs/**/*",
      "sample/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/sql.js/dist/*.wasm",
      "**/bluebird/**",
      "**/readable-stream/**"
    ],
    "extraResources": [
      {
        "from": "data/llmwiki",
        "to": "llmwiki"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "@electron/asar": "^4.3.0",
    "unzipper": "^0.12.3",
    "rimraf": "^4.4.1",
    "glob": "^13.0.6",
    "uuid": "^11.1.1",
    "fast-csv": "^5.0.7",
    "archiver": "^7.0.1"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "sql.js": "^1.14.1",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  }
}
