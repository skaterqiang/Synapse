plugin/
plugins/

# ========================
# 环境与密钥（防止 API Key / SK / AK 泄露）
# ========================
.env
.env.*
.env.local
.env.production
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ak
*.sk
*secret*
*credential*
*api_key*
*apikey*
*access_key*
*token.json
keys.json
config.local.json

# ========================
# 数据库文件（包含 API Key 等敏感设置）
# ========================
*.db
*.db.bak*
*.db.tmp
db-path.json
knowledge-data.json
knowledge-data.json.bak*
wiki-jobs.json
wiki-jobs.json.bak*

# ========================
# 备份文件（可能含敏感数据）
